@model MareneStore.Web.Models.ProductViewModel

<style>
    .product-card {
        max-width: 320px;
        margin: 0 auto;
        transition: transform 0.2s;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }

    .stock-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        z-index: 1;
    }
</style>

@{
    ViewBag.Title = "Product List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🛍️ Our Products</h2>
        @if (User.Identity.IsAuthenticated)
        {
            <a href="@Url.Action("ShopIndex", "ShoppingCart")" class="btn btn-outline-primary">
                <i class="bi bi-cart"></i> View Cart
            </a>
        }
    </div>

    @if (Model.Items == null || !Model.Items.Any(x => x.IsActive && x.Stock > 0))
    {
        <div class="alert alert-warning">
            <h4>No products available</h4>
            <p>There are currently no products in stock. Please check back later.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model.Items.Where(x => x.IsActive && x.Stock > 0))
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm product-card">
                        <!-- Badge de stock -->
                        @if (item.Stock <= 5)
                        {
                            <span class="badge bg-warning stock-badge">Only @item.Stock left!</span>
                        }

                        <!-- Imagen -->
                        <div class="text-center pt-3">
                            <img src="@item.ImageUrl"
                                 style="max-width:200px; max-height:150px; width:auto; height:auto; display:block; margin:0 auto;"
                                 alt="@item.Name"
                                 class="img-fluid" />
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="card-text text-muted">@item.Description</p>

                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h4 class="text-success mb-0">@item.Price.ToString("C")</h4>
                                </div>

                                <!-- Formulario para cantidad -->
                                <form method="post" action="@Url.Action("Add", "ShoppingCart")">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="id" value="@item.Id" />

                                    <div class="input-group mb-2">
                                        <span class="input-group-text">Quantity:</span>
                                        <input type="number"
                                               name="quantity"
                                               value="1"
                                               min="1"
                                               max="@item.Stock"
                                               class="form-control"
                                               style="max-width: 80px;" />
                                    </div>

                                    <button type="submit" class="btn btn-success w-100">
                                        <i class="bi bi-cart-plus"></i> Add to Cart
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Paginación -->
        <div class="d-flex justify-content-between align-items-center mt-4">
            <div>
                <label for="pageSize" class="me-2">Items per page:</label>
                <select id="pageSize" class="form-select d-inline-block w-auto" onchange="changePageSize(this.value)">
                    <option value="5" @(Model.PageSize == 5 ? "selected" : "")>5</option>
                    <option value="10" @(Model.PageSize == 10 ? "selected" : "")>10</option>
                    <option value="20" @(Model.PageSize == 20 ? "selected" : "")>20</option>
                </select>
            </div>
            <nav>
                <ul class="pagination mb-0">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("ShopIndex", "Product", new { pageNumber = Model.PageNumber - 1, pageSize = Model.PageSize })">
                            <i class="bi bi-chevron-left"></i> Previous
                        </a>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">Page @Model.PageNumber</span>
                    </li>
                    <li class="page-item @(Model.PageNumber * Model.PageSize >= Model.TotalCount ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("ShopIndex", "Product", new { pageNumber = Model.PageNumber + 1, pageSize = Model.PageSize })">
                            Next <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<script>
    function changePageSize(pageSize) {
        const url = '@Url.Action("ShopIndex", "Product")';
        window.location.href = `${url}?pageNumber=1&pageSize=${pageSize}`;
    }
</script>
