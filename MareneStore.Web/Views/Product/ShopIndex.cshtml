@model MareneStore.Web.Models.ProductViewModel

<style>
    .product-card {
        max-width: 320px;
        margin: 0 auto;
    }
</style>

@{
    ViewBag.Title = "Product List";
}

<div class="container">
    <div class="row">
        @foreach (var item in Model.Items.Where(x => x.IsActive && x.Stock > 0))
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm product-card">

                    <!-- Imagen -->
                    <img src="@item.ImageUrl"
                         style="max-width:200px; max-height:150px; width:auto; height:auto; display:block; margin:0 auto;"
                         alt="@item.Name" />

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text">@item.Description</p>
                        <p class="fw-bold text-success">
                            @item.Price.ToString("C")
                        </p>

                        <!-- Formulario para cantidad -->
                        <form method="post" action="@Url.Action("Add", "ShoppingCart")">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="id" value="@item.Id" />

                            <div class="mb-2">
                                <label>Cantidad:</label>
                                <input type="number"
                                       name="quantity"
                                       value="1"
                                       min="1"
                                       max="@item.Stock"
                                       class="form-control" />
                            </div>

                            <button type="submit" class="btn btn-success w-100 mt-auto">
                                🛒 Agregar al carrito
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }

    </div>

    <div class="d-flex justify-content-between align-items-center">
        <div>
            <label for="pageSize" class="mr-2">Page Size:</label>
            <select id="pageSize" class="form-control d-inline-block w-auto" onchange="changePageSize(this.value)">
                <option value="5" @(Model.PageSize == 5 ? "selected" : "")>5</option>
                <option value="10" @(Model.PageSize == 10 ? "selected" : "")>10</option>
                <option value="20" @(Model.PageSize == 20 ? "selected" : "")>20</option>
            </select>
        </div>
        <nav>
            <ul class="pagination mb-0">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", "Product", new { pageNumber = Model.PageNumber - 1, pageSize = Model.PageSize })">❮</a>
                </li>
                <li class="page-item @(Model.PageNumber * Model.PageSize >= Model.TotalCount ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", "Product", new { pageNumber = Model.PageNumber + 1, pageSize = Model.PageSize })">❯</a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<script>
    function changePageSize(pageSize) {
        const url = '@Url.Action("Index", "Product")';
        window.location.href = `${url}?pageNumber=1&pageSize=${pageSize}`;
    }
</script>
