@{
    ViewBag.Title = "Home";
}

<main>
    <div class="jumbotron">
        <h1>MareneStore</h1>
        <p class="lead">Welcome to your premier marketplace for the best products. Built with .NET for the Web Engineering Master's program at UPM.</p>
        <p><a href="@Url.Action("About", "Home")" class="btn btn-primary btn-lg">Learn more &raquo;</a></p>
    </div>

    <div class="row">
        <div class="col-md-4">
            <h2>Marketplace</h2>
            <p>
                Browse our extensive catalog of products. We offer a seamless shopping experience
                connecting buyers and sellers in a modern e-commerce environment.
            </p>
        </div>
        <div class="col-md-4">
            <h2>API Integration</h2>
            <p>
                Our platform is powered by a robust RESTful API, ensuring data consistency
                and allowing for future integrations and scalability.
            </p>
        </div>
        <div class="col-md-4">
            <h2>Admin Features</h2>
            <p>
                Comprehensive administration tools allow for easy management of products,
                stock levels, and user oversight to keep the market running smoothly.
            </p>
        </div>
    </div>
</main>