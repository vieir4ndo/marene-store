@{
    ViewBag.Title = "About Us";
}
<main aria-labelledby="title">
    <h2 id="title">@ViewBag.Title</h2>

    <p>
        <strong>MareneStore</strong> is a .NET Framework application developed as a practical assignment
        for the <em>Master's Degree in Web Engineering</em> at <a href="https://www.upm.es/">Universidad Politécnica de Madrid (UPM)</a>.
    </p>

    <p>
        The application simulates a full-featured marketplace, demonstrating core concepts of web development
        such as API design, MVC architecture, and Role-based security.
    </p>

    <h4>The Team</h4>
    <ul>
        <li><strong>Matheus Vieira Santos</strong> - Developer</li>
        <li><strong>Irene Recio</strong> - Developer</li>
    </ul>
</main>