@model MareneStore.Web.Models.ShoppingCart
@{
    ViewBag.Title = "My Shopping Cart";
}

<div class="container mt-4">
    <h2>🛒 My Shopping Cart</h2>

    @if (Model?.Items == null || !Model.Items.Any())
    {
        <p>No hay productos en el carrito.</p>
        <a href="@Url.Action("Index", "Producto")" class="btn btn-primary mt-2">
            Volver a la tienda
        </a>
    }
    else
    {
        <table class="table table-striped mt-3">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Precio Unitario</th>
                    <th>Cantidad</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Price.ToString("C")</td>
                        <td>@item.Quantity</td>
                        <td>@(item.Price * item.Quantity).ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>

        <h4 class="mt-3">
            Total general: @Model.Items.Sum(x => x.Price * x.Quantity).ToString("C")
        </h4>

        <div class="mt-3">
            <a href="@Url.Action("Index", "Producto")" class="btn btn-secondary">
                Continue buying
            </a>
            <a href="@Url.Action("Checkout", "Order")" class="btn btn-success">
                Order products
            </a>
        </div>
    }
</div>
