@model MareneStore.Web.Models.ShoppingCart
@{
    ViewBag.Title = "My Shopping Cart";
}

<div class="container mt-4">
    <h2>🛒 My Shopping Cart</h2>

    @if (Model?.Items == null || !Model.Items.Any())
    {
        <div class="alert alert-info mt-4">
            <h4>Your cart is empty</h4>
            <p>Start adding products to your cart!</p>
        </div>
        <a href="@Url.Action("ShopIndex", "Product")" class="btn btn-primary mt-2">
            <i class="bi bi-shop"></i> Continue Shopping
        </a>
    }
    else
    {
        <div class="row mt-4">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-body">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Subtotal</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                {
                                                    <img src="@item.ImageUrl"
                                                         alt="@item.Name"
                                                         style="width: 60px; height: 60px; object-fit: cover; margin-right: 15px;"
                                                         class="rounded" />
                                                }
                                                <strong>@item.Name</strong>
                                            </div>
                                        </td>
                                        <td class="align-middle">
                                            <span class="text-success fw-bold">@item.Price.ToString("C")</span>
                                        </td>
                                        <td class="align-middle">
                                            <form method="post" action="@Url.Action("UpdateQuantity", "ShoppingCart")" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.ProductId" />
                                                <div class="input-group" style="max-width: 130px;">
                                                    <input type="number"
                                                           name="quantity"
                                                           value="@item.Quantity"
                                                           min="1"
                                                           class="form-control form-control-sm" />
                                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                                        <i class="bi bi-check"></i>
                                                    </button>
                                                </div>
                                            </form>
                                        </td>
                                        <td class="align-middle">
                                            <strong>@((item.Price * item.Quantity).ToString("C"))</strong>
                                        </td>
                                        <td class="align-middle">
                                            <form method="post" action="@Url.Action("Remove", "ShoppingCart")" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.ProductId" />
                                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to remove this product?')">
                                                    <i class="bi bi-trash"></i> Remove
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-3">
                    <form method="post" action="@Url.Action("Clear", "ShoppingCart")" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to clear the entire cart?')">
                            <i class="bi bi-trash"></i> Clear Cart
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Products (@Model.Items.Sum(x => x.Quantity)):</span>
                            <strong>@Model.Items.Sum(x => x.Price * x.Quantity).ToString("C")</strong>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between mb-3">
                            <h5>Total:</h5>
                            <h5 class="text-success">@Model.Items.Sum(x => x.Price * x.Quantity).ToString("C")</h5>
                        </div>

                        <a href="@Url.Action("Checkout", "Order")" class="btn btn-success w-100 mb-2">
                            <i class="bi bi-bag-check"></i> Proceed to Checkout
                        </a>

                        <a href="@Url.Action("ShopIndex", "Product")" class="btn btn-outline-primary w-100">
                            <i class="bi bi-arrow-left"></i> Continue Shopping
                        </a>
                    </div>
                </div>

                <div class="alert alert-info mt-3">
                    <small>
                        <i class="bi bi-info-circle"></i>
                        <strong>Note:</strong> Stock availability will be verified at checkout.
                    </small>
                </div>
            </div>
        </div>
    }
</div>

@section scripts {
    <script>
        // Auto-submit form on quantity change (opcional)
        $(document).ready(function() {
            $('input[name="quantity"]').on('change', function() {
                // Puedes descomentar esto si quieres que se actualice automáticamente
                // $(this).closest('form').submit();
            });
        });
    </script>
}
