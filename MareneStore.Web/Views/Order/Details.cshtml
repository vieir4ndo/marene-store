@model MareneStore.Application.Dtos.OrderDto

@{
    ViewBag.Title = "Order Details";
}

<h1>Order Details</h1>

<div>
    <p><strong>Order ID:</strong> @Model.Id</p>
    <p><strong>Date:</strong> @Model.Date.ToString("f")</p>
    <p><strong>Total Amount:</strong> @Model.TotalAmount.ToString("C")</p>
    <p><strong>Status:</strong> @Model.Status</p>
    <p><strong>Customer Name:</strong> @Model.UserName</p>
    <p><strong>Customer Email:</strong> @Model.UserEmail</p>
    <p><strong>Shipping Address:</strong> @Model.UserShippingAddress</p>
</div>

<div>
    <h3>Order Items</h3>
    <table class="table">
        <thead>
            <tr>
                <th></th>
                <th>Product</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Details)
            {
                <tr>
                    <td>
                        <img src="@item.ProductImageUrl" alt="Product" style="max-height: 100px; max-width: 100px; object-fit: cover;" />
                    </td>
                    <td>@item.ProductName</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("C")</td>
                    <td>@((item.Quantity * item.UnitPrice).ToString("C"))</td>
                </tr>
            }
        </tbody>
    </table>
</div>